# Copy to .env and fill in. Never commit .env.

# --- known path (known_incidents/) ---
LLM_PROVIDER=offline            # offline (no key, $0) or openai
CHEAP_MODEL=gpt-4o-mini         # first try for every LLM step
STRONG_MODEL=gpt-4o             # only when the cheap model is unsure
JUDGE_MODEL=gpt-4o-mini         # evaluation only
MAX_RUN_USD=0.50                # hard cap per run
MAX_TICKET_USD=0.05             # hard cap per ticket

# --- shared ---
OPENAI_API_KEY=

# --- unknown path (unknown_incidents/): runs only when both keys are set ---
PINECONE_API_KEY=
OPENAI_MODEL=gpt-4o-mini        # Tier 1 classifier
TIER2_MODEL=gpt-4o-mini         # Tier 2 investigator
